# ── Servidor ──────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=troca-esta-frase-por-qualquer-coisa-longa-e-aleatoria
# atrás de nginx/Caddy:
# TRUST_PROXY=1
# atrás de Cloudflare às vezes é preciso:
# INSECURE_COOKIES=1

# ── Primeiro utilizador admin (cria-se só na 1ª corrida) ──
ADMIN_USER=trama
ADMIN_PASSWORD=muda-isto-ja

# ── Stripe (checkout: cartão + Multibanco + MB WAY em PT) ─
# chaves em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_cole_aqui
STRIPE_WEBHOOK_SECRET=whsec_cole_aqui

# ── Email (envio de notificações de encomenda/envio/recogida) ~/.env
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
MAIL_FROM="Livraria Trama <livrariatrama@gmail.com>"

# ── Anti-spam do chat ─
CHAT_SALT=qualquer-frase-secreta-aqui
